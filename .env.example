# Authority environment variables
# Copy to .env and fill in real values:
#   cp .env.example .env

# Required: JWT signing secret (at least 32 characters, high entropy)
AUTHORITY_JWT_SECRET_KEY=

# Required for MFA: Fernet key.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTHORITY_FERNET_KEY=

# Optional: path to the SQLite database file
AUTHORITY_DB_PATH=authority_data.db

# Optional: HIBP API key for breached-password checks
#AUTHORITY_HIBP_KEY=

# Optional: WebAuthn relying party ID and expected origin
#AUTHORITY_WEBAUTHN_RP_ID=
#AUTHORITY_WEBAUTHN_ORIGIN=
